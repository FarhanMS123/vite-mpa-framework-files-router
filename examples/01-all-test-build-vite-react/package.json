{
  "name": "01-all-test-build-vite-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare:upper": "pushd . && cd ../.. && npm run build:tsc && (shx rm package.tgz || echo .) && npm run pack && popd",
    "prepare:module": "npm uninstall vite-plugin-virtual-files && npm i --legacy-peer-deps ../../package.tgz && (shx rm ../../package.tgz || echo .)",
    "prepare": "npm run prepare:upper && npm run prepare:module",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:simple": "npm run prepare && vite build -c",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite-plugin-virtual-files": "file:../../package.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react-swc": "^3.10.2",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "shx": "^0.4.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.4"
  }
}
