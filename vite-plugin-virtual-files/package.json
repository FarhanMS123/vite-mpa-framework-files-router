{
  "name": "@qten-beanprint/vite-plugin-virtual-files",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "version": "0.1.0",
  "type": "module",
  "description": "Virtual files inclusion with few basic html root template",
  "main": "dist/files-router.js",
  "module": "src/files-router.ts",
  "types": "dist/files-router.d.ts",
  "readme": "./README.md",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "require": {
        "types": "./dist/files-router.d.ts",
        "default": "./dist/files-router.js"
      },
      "import": {
        "types": "./dist/files-router.d.ts",
        "default": "./dist/files-router.js"
      }
    },
    "./*": {
      "require": {
        "types": "./*/*.d.ts",
        "default": "./*/*.js"
      },
      "import": {
        "types": "./*/*.d.ts",
        "default": "./*/*.js"
      }
    },
    "./esm": null,
    "./modern": null
  },
  "scripts": {
    "build": "npm run build:tsc && npm run cp:meta && npm run cp:src",
    "build:tsc": "tsc -b",
    "pack": "npm pack && shx mv *-vite-plugin-virtual-files-*.tgz package.tgz",
    "cp:meta": "shx cp package.json README.md tsconfig.json .eslintrc.cjs .gitignore .npmignore dist/",
    "cp:src": "shx cp src/** dist"
  },
  "keywords": [],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FarhanMS123/qten-beanprint.git",
    "directory": "vite-plugin-virtual-files"
  },
  "author": "FarhanMS123",
  "license": "ISC",
  "dependencies": {
    "resolve": "^1.22.10"
  },
  "devDependencies": {
    "@types/micromatch": "^4.0.7",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/resolve": "^1.20.6",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.4",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "shx": "^0.4.0",
    "typescript": "^5.2.2",
    "vite-plugin-inspect": "^0.8.1"
  },
  "peerDependencies": {
    "create-vite": "5.3.0",
    "fast-glob": "^3.3.3",
    "micromatch": "^4.0.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "scheduler": "^0.23.2",
    "vite": "^5.3.1",
    "vite-tsconfig-paths": "^4.3.2",
    "vue": "^3.4.29"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "tsconfig.json",
    ".npmignore",
    ".gitignore",
    ".eslintrc.cjs"
  ]
}
