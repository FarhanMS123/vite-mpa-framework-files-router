{
  "devDependencies": {
    "@types/node": "^24.3.0",
    "jsonpath": "^1.1.1",
    "nanoid": "^5.1.5",
    "rollup": "^4.46.2",
    "typescript": "^5.9.2",
    "undici-types": "^7.13.0",
    "vite": "^7.1.1"
  },
  "name": "@qten-beanprint/vite-plugin-inspect",
  "version": "0.0.1",
  "main": "dist/main.ts",
  "dependencies": {
    "esbuild": "^0.25.8"
  },
  "module": "src/files-router.ts",
  "types": "dist/files-router.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "require": {
        "types": "./dist/files-router.d.ts",
        "default": "./dist/files-router.js"
      },
      "import": {
        "types": "./dist/files-router.d.ts",
        "default": "./dist/files-router.js"
      }
    },
    "./*": {
      "require": {
        "types": "./*/*.d.ts",
        "default": "./*/*.js"
      },
      "import": {
        "types": "./*/*.d.ts",
        "default": "./*/*.js"
      }
    },
    "./esm": null,
    "./modern": null
  },
  "scripts": {
    "build": "tsc -b"
  },
  "author": "FarhanMS123",
  "license": "ISC",
  "description": "",
  "files": [
    "dist",
    "src",
    "README.md",
    "tsconfig.json",
    ".npmignore",
    ".gitignore",
    ".eslintrc.cjs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FarhanMS123/vite-mpa-framework-files-router.git"
  }
